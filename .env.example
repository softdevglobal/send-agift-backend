APP_PORT=8081
DB_HOST=localhost
DB_PORT=5432
DB_USER=postgres
DB_PASSWORD=
DB_NAME=sendagift_db
DB_SSLMODE=disable
JWT_SECRET=
JWT_EXPIRY_MINUTES=1440
BOOTSTRAP_SECRET=

# AWS S3
AWS_REGION=ap-southeast-2
# Local development only. Leave both empty on AWS: the ECS task role
# supplies credentials there.
AWS_ACCESS_KEY_ID=
AWS_SECRET_ACCESS_KEY=
S3_BUCKET=

# Google Places
GOOGLE_MAPS_API_KEY=


# Push notifications (Firebase Cloud Messaging). A service-account key from
# Firebase console > Project settings > Service accounts > Generate new
# private key. Set the file path, or paste the JSON into the second variable.
# Without either, notifications wait in the queue until one is set.
FIREBASE_CREDENTIALS_FILE=
FIREBASE_CREDENTIALS_JSON=
