APP_PORT=8081
DB_HOST=localhost
DB_PORT=5432
DB_USER=postgres
DB_PASSWORD=
DB_NAME=sendagift_db
DB_SSLMODE=disable
JWT_SECRET=
JWT_EXPIRY_MINUTES=1440
BOOTSTRAP_SECRET=

# AWS S3
AWS_REGION=ap-southeast-2
# Local development only. Leave both empty on AWS: the ECS task role
# supplies credentials there.
AWS_ACCESS_KEY_ID=
AWS_SECRET_ACCESS_KEY=
S3_BUCKET=

# Google Places
GOOGLE_MAPS_API_KEY=


# Push notifications (Firebase Cloud Messaging). A service-account key from
# Firebase console > Project settings > Service accounts > Generate new
# private key. Set the file path, or paste the JSON into the second variable.
# Without either, notifications wait in the queue until one is set.
FIREBASE_CREDENTIALS_FILE=
FIREBASE_CREDENTIALS_JSON=

# Transactional email (ZeptoMail). The Send Mail token from your Mail Agent,
# and a sender address on a domain verified there. Without a token, emails
# queue up and are sent once one is set. ZEPTOMAIL_API_URL must match the
# data centre the token belongs to. A token from another region is rejected
# as "Invalid API Token". US: https://api.zeptomail.com/v1.1/email (default),
# Australia: https://api.zeptomail.com.au/v1.1/email, EU: .eu, India: .in.
ZEPTOMAIL_SYSTEM_TOKEN=
ZEPTOMAIL_SYSTEM_FROM_ADDRESS=
ZEPTOMAIL_SYSTEM_FROM_NAME=SendAGift
ZEPTOMAIL_API_URL=
# The customer website, for links in emails.
APP_WEB_URL=http://localhost:5173
